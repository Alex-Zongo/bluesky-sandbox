    "task_info_providers": [],
    "hook_setup": "import bluesky as bs\nimport numpy as np\nfrom bluesky.tools.aero import kts, vcas2tas\n\nfrom bluesky_sandbox.sim.geometry.conflict import detection\n\n# Spacing over VALPU, in time behind the previous aircraft: time is what the\n# runway receives. Target 110 s; minimum 75 s, about 3 NM at 140 kt on final.\nSPACING_S = 110.0\nMIN_SPACING_S = 75.0\n# Delay cost, per minute flown.\nTIME_COST_PER_MIN = 0.1\n# Workload cost, per speed reduction given.\nCLEARANCE_COST = 0.02\n# Potential-based shaping on predicted conflicts (Ng et al., 1999): it signals\n# a conflict minutes before the loss without changing the optimal policy,\n# provided SHAPING_GAMMA equals PPO's discount (SB3's default, 0.99).\nSHAPING_WEIGHT = 0.2\nSHAPING_GAMMA = 0.99\n# Distance from the threshold at which an aircraft has landed, NM.\nLANDED_NM = 0.3\n\n\ndef slow_from_m(idx, cas_kts):\n    \"\"\"Distance before a fix at which the aircraft at ``idx`` starts slowing to\n    cross it at ``cas_kts``, m: twice its deceleration distance, since it slows\n    less while descending, plus its fly-by turn distance. BlueSky's VNAV uses\n    the deceleration distance alone and crosses fixes too fast.\"\"\"\n    target = vcas2tas(cas_kts * kts, bs.traf.alt[idx])\n    slowing = 0.5 * abs(bs.traf.tas[idx] ** 2 - target**2) / max(float(bs.traf.perf.axmax[idx]), 0.001)\n    return 2.0 * slowing + float(bs.traf.actwp.turndist[idx])\n\n\ndef spacing_score(gap_s):\n    \"\"\"Score of a gap of ``gap_s`` behind the previous aircraft over VALPU: 0 at\n    ``SPACING_S`` or more, falling linearly to -1 at ``MIN_SPACING_S``. The\n    first aircraft, with no gap, scores 0.\"\"\"\n    if gap_s is None:\n        return 0.0\n    short = (SPACING_S - gap_s) / (SPACING_S - MIN_SPACING_S)\n    return -min(max(short, 0.0), 1.0)\n\n\ndef potential(idx, horizon_s):\n    \"\"\"Shaping potential of the aircraft at ``idx``: ``-SHAPING_WEIGHT`` per\n    predicted loss of separation, weighted from 0 at ``horizon_s`` ahead to 1\n    when in loss now. The prediction is BlueSky's own conflict detection.\"\"\"\n    soon = np.clip(1.0 - detection().tlos_s[idx] / horizon_s, 0.0, 1.0)\n    soon[idx] = 0.0\n    return -SHAPING_WEIGHT * float(soon.sum())\n",
    "hooks": {
      "cost": "# Seconds in loss of separation this step: the constrained quantity (limit 0).\nreturn float(context.separation.los.time.during_step_s)\n",
      "on_agent_done": "# Past VALPU the approach takes over: the aircraft flies on as background\n# traffic that later arrivals must stay clear of. Any other end removes it.\nreturn AircraftControlState.BACKGROUND if terminated else AircraftControlState.DELETE\n",
      "on_aircraft_spawned": "# BlueSky leaves VNAV off for a route given after creation: switch it on to\n# fly the published altitudes. Clearing the current speed turns VNAV speed off,\n# since on_sim_step manages speed instead: VNAV crosses fixes too fast.\nbs.stack.stack(f\"VNAV {callsign} ON\")\nidx = bs.traf.id.index(callsign)\nbs.stack.stack(f\"SPD {callsign} {bs.traf.cas[idx] / kts:.0f}\")\n",
      "on_episode_reset": "# Per-episode state: when the last aircraft crossed VALPU, for the spacing\n# score, and each aircraft's last potential, for the shaping.\nself.last_over_merge_s = None\nself.potentials = {}\n",
      "on_sim_step": "# Every simulator substep, so neither landing nor slowing is late by a step.\nfor idx, acid in enumerate(bs.traf.id):\n    context = self.agent_context(idx)\n    # At the threshold the aircraft has landed.\n    if context.query(\"RW01L\").current.distance_nm < LANDED_NM:\n        self.mark_aircraft_for_deletion(acid)\n        continue\n    # Cross the active fix no faster than its published speed, slowing just in\n    # time; a lower cleared speed is kept.\n    active = context.route.active\n    published = None if active is None else active.crossing.speed_kts\n    if (\n        published is not None\n        and bs.traf.selspd[idx] / kts > published + 0.5\n        and bs.traf.ap.dist2wp[idx] < slow_from_m(idx, published)\n    ):\n        bs.stack.stack(f\"SPD {acid} {published:.0f}\")\n",
      "reward": "# Delay: every step flown.\nr = -TIME_COST_PER_MIN * self.config.dt / 60.0\n# Workload: a speed reduction given this step.\nif context.applied[\"ap_spd_delta_kts\"]:\n    r -= CLEARANCE_COST\n# Spacing: scored once, as the aircraft crosses VALPU.\nif terminated:\n    now = float(bs.sim.simt)\n    gap = None if self.last_over_merge_s is None else now - self.last_over_merge_s\n    self.last_over_merge_s = now\n    r += spacing_score(gap)\n# Shaping: the potential's change, with the potential 0 at the flight's end.\nnow = 0.0 if terminated else potential(context.acidx, self.config.lookahead_s)\nr += SHAPING_GAMMA * now - self.potentials.get(context.acid, 0.0)\nself.potentials[context.acid] = now\nreturn r\n",
      "terminated": "# The flight ends at VALPU, the IAF, where the approach takes over.\nreturn context.query(\"VALPU\").step.reached\n",
      "truncated": "# Never: every flight reaches VALPU.\nreturn False\n"
    },
