          "weights": {
            "A320": 1,
            "A321": 1,
            "B738": 1,
            "B739": 1,
            "E190": 1
          }
        },
        "route": null,
        "conflict_free_spawn": true,
        "render_shape": true,
        "render_name": true,
        "route_rule": "# Straight through a point drawn in the crossing area, on to where that\n# line leaves the airspace: every track crosses the center area, and an\n# aircraft handed back its route flies on outward, not back into the\n# encounter.\ncross = ctx.shapes[\"crossing\"].sample_point(rng)\ntrack, _ = kwikqdrdist(request.at.lat_deg, request.at.lon_deg, *cross)\nlat, lon = cross\nwhile ctx.airspace.contains(lat, lon):\n    lat, lon = qdrpos(lat, lon, track, 1.0)\nreturn [{\"waypoint\": \"exit\", \"sample\": RegionBounds(PointFootprint(LatLon(lat, lon)))}]\n"
      }
    ]
  },
