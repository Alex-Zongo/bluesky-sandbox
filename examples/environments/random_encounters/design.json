    "routes": {},
    "regions": [
      {
        "type": "spawn_region",
        "shape": {
          "ref": "entry"
        },
        "name": "ENTRY",
        "n_aircraft": {
          "type": "scipy",
          "name": "randint",
          "args": [],
          "kwds": {
            "low": 2,
            "high": 7,
            "loc": 0
          }
        },
        "params": {
          "alt_ft": 20000,
          "spd_kts": {
